#!/bin/bash
# popup-nas autorun entrypoint. SystemRescue's autorun mechanism runs any
# file here named autorun/autorun0 through autorun/autorunF automatically
# after console login (see docs/architecture.md). This script IS the
# interactive session for whoever is at the keyboard — it never silently
# hands back to a bare root prompt; "Drop to shell" in the menu is explicit.
set -uo pipefail

MEDIA_MOUNTPOINT="/mnt/popup-media"

is_our_autorun_folder() {
  # $1 = a directory to check. True if it's genuinely our autorun folder
  # (not just something that happens to be named "autorun").
  [ -f "$1/autorun0" ] && [ -d "$1/lib" ]
}

# $1 = a directory to check. True if the filesystem backing it is a real
# on-disk type, so writes made there reach the physical boot media and
# survive a reboot. False for RAM-backed types (tmpfs, ramfs, overlay,
# squashfs, or unknown) - including, critically, whatever temporary copy
# SystemRescue's own autorun mechanism makes before running our scripts
# (see the "copytoram" comment on scan_all_partitions below). Found on
# real hardware 2026-10-02: find_media_root()'s broad search could land
# on exactly such a RAM copy and accept it, since it has all the right
# files - at which point self_update() and everything else kept
# "succeeding" for the rest of that boot session, while never actually
# reaching the real stick at all, silently reverting on the next reboot.
is_real_disk_backed() {
  local path="$1" fstype
  fstype=$(findmnt -T "$path" -no FSTYPE 2>/dev/null)
  case "$fstype" in
    ""|tmpfs|ramfs|overlay|squashfs|devtmpfs) return 1 ;;
    *) return 0 ;;
  esac
}

find_media_root() {
  # First, cheap guess: maybe our autorun folder is already mounted
  # somewhere obvious. True on some setups, but not reliably true on real
  # hardware - kept only as a fast first attempt. Must also be backed by
  # real disk (see is_real_disk_backed above) - otherwise this can match
  # SystemRescue's own temporary RAM copy instead of the real stick, and
  # every later write would be silently thrown away on reboot.
  local d
  for d in $(find /run /media /mnt /root 2>/dev/null -maxdepth 6 -type d -name autorun); do
    if is_our_autorun_folder "$d" && is_real_disk_backed "$d"; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

scan_all_partitions() {
  # SystemRescue's autorun feature copies our scripts elsewhere (into RAM
  # - see is_real_disk_backed above) and (it seems) unmounts the stick
  # again before actually running them - so there's usually nothing to
  # find mounted at all by this point. And we can't rely on a custom
  # volume label either: Rufus keeps the SystemRescue ISO's own label
  # (e.g. RESCUE1302) when writing it in image mode, and Windows'
  # rename/label tools don't override that.
  #
  # So instead: try every partition on the machine, read-only, and check
  # each one for our own folder. This machine only just booted, so there
  # are never more than a handful of partitions to try - it's fast, and it
  # doesn't care what any tool decided to call the drive. Every candidate
  # here is a genuine block device partition (from lsblk), never RAM, so
  # no is_real_disk_backed() check is needed on top of this one.
  local dev
  udevadm settle --timeout=5 2>/dev/null || true
  mkdir -p "$MEDIA_MOUNTPOINT"
  #
  # "rom" (a CD/DVD drive, real or virtual) is tried as well as "part": an
  # ISO booted in a VM shows up as /dev/sr0 of TYPE "rom", never as a
  # partition, so a partitions-only search could never find our folder on
  # it. Found 2026-10-05 booting a built popup-nas.iso in VirtualBox.
  for dev in $(lsblk -rno NAME,TYPE 2>/dev/null | awk '$2=="part"||$2=="rom"{print "/dev/"$1}'); do
    mount | grep -q "^$dev " && continue
    if mount -o ro "$dev" "$MEDIA_MOUNTPOINT" 2>/dev/null; then
      if is_our_autorun_folder "$MEDIA_MOUNTPOINT/autorun"; then
        echo "$MEDIA_MOUNTPOINT/autorun"
        return 0
      fi
      umount "$MEDIA_MOUNTPOINT" 2>/dev/null
    fi
  done
  return 1
}

# Writes a tiny "menu" shell function to /etc/profile.d/, so a fresh SSH
# login later in this same boot session - a separate session from this
# console one, which inherits neither $HERE nor anything sourced into this
# session - can get back to a current, interactive menu without retyping
# the whole git-clone-and-relaunch sequence by hand. A plain alias can't
# safely hold a multi-step sequence with conditionals like this one
# (quoting and error-handling get fragile); a function handles it
# properly. Rewritten fresh on every boot, so it always reflects this
# boot's own $HERE and UPDATE_REPO_URL/UPDATE_BRANCH (from popup-nas.conf,
# if set) rather than whatever they were on some earlier boot.
#
# $1 must be the REPO ROOT (the folder containing autorun/ and
# sysrescue.d/ as siblings) - NOT $HERE itself, which is the autorun/
# folder one level further in. Found on real hardware 2026-10-02: this
# was called with $HERE directly, so every path inside the generated
# menu() function below ended up one folder too deep (checking for
# autorun/autorun, copying into autorun/autorun/, running
# autorun/autorun/autorun0) - meaning `menu` always failed its own
# sanity check and never worked at all, on any stick, until caught by a
# real test. See the call site at the bottom of this file.
write_ssh_menu_helper() {
  local root="$1" repo_url repo_branch
  repo_url=$(update_repo_url)
  repo_branch=$(update_repo_branch)
  mkdir -p /etc/profile.d
  cat > /etc/profile.d/popup-nas-tools.sh <<EOF
# Written by popup-nas's autorun0 at boot - see autorun/autorun0.
menu() {
  local root="$root" fresh
  if [ ! -d "\$root/autorun" ]; then
    echo "menu: \$root doesn't look like this box's boot media any more - check 'lsblk' by hand." >&2
    return 1
  fi
  fresh=\$(mktemp -d)
  if ! git clone --quiet --branch "$repo_branch" --single-branch "$repo_url" "\$fresh"; then
    echo "menu: couldn't clone $repo_url - check network and try again." >&2
    rm -rf "\$fresh"
    return 1
  fi
  [ -f "\$root/autorun/popup-nas.conf" ] && cp "\$root/autorun/popup-nas.conf" "\$fresh/autorun/popup-nas.conf"
  cp -r "\$fresh/." "\$root/"
  rm -rf "\$fresh"
  bash "\$root/autorun/autorun0"
}
EOF
}

HERE="$(find_media_root)"
if [ -z "${HERE:-}" ]; then
  HERE="$(scan_all_partitions)"
fi
if [ -z "${HERE:-}" ]; then
  clear
  echo "popup-nas: couldn't find its own autorun folder on any partition on this machine."
  echo ""
  echo "Partitions this machine can see right now:"
  echo ""
  lsblk -o NAME,LABEL,FSTYPE,SIZE,MOUNTPOINT 2>/dev/null
  echo ""
  echo "blkid output:"
  blkid 2>/dev/null
  echo ""
  echo "Tell Claude what's listed above (a photo of this screen is fine)."
  exec bash
fi
export HERE
LIB="$HERE/lib"

# shellcheck source=lib/network.sh
source "$LIB/network.sh"
# shellcheck source=lib/selfupdate.sh
source "$LIB/selfupdate.sh"
# shellcheck source=lib/partition.sh
source "$LIB/partition.sh"
# shellcheck source=lib/samba.sh
source "$LIB/samba.sh"
# shellcheck source=lib/fleet.sh
source "$LIB/fleet.sh"
# shellcheck source=lib/populate.sh
source "$LIB/populate.sh"
# shellcheck source=lib/display.sh
source "$LIB/display.sh"
# shellcheck source=lib/build.sh
source "$LIB/build.sh"
# shellcheck source=lib/menu.sh
source "$LIB/menu.sh"

# Per-site config baked onto the stick alongside this script.
CONF="$HERE/popup-nas.conf"
if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090
  source "$CONF"
fi

clear
echo "=== popup-nas ==="
echo ""
wait_for_network
self_update
# $HERE is the autorun/ folder itself - write_ssh_menu_helper() needs the
# REPO ROOT one level up from that (see its own comment above), the same
# way self_update() works out repo_root for itself in lib/selfupdate.sh.
write_ssh_menu_helper "$(cd "$HERE/.." 2>/dev/null && pwd)"

HOSTNAME_VALUE=$(ask_hostname)
hostnamectl set-hostname "$HOSTNAME_VALUE" 2>/dev/null || true

start_fleet_broadcast "$HOSTNAME_VALUE"

main_menu "$HOSTNAME_VALUE"
